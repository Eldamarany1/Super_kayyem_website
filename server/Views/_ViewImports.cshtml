@* ============================================================
   _ViewImports.cshtml — Shared imports across all Razor views
   Every line here is automatically applied to every View in the project.
   ============================================================ *@

@* Import the root namespace of the project — enables using its classes directly *@
@using SuperKayyem

@* Import the models namespace — allows writing "Story" directly instead of "SuperKayyem.Models.Story" *@
@using SuperKayyem.Models

@* Enable Tag Helpers: allows using asp-action, asp-for, asp-route-id... in HTML
   * means "from all assemblies", Microsoft.AspNetCore.Mvc.TagHelpers is the official library *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

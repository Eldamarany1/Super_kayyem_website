@model SuperKayyem.ViewModels.JoinTeamViewModel
@{
    Layout = null;
    ViewData["Title"] = "انضم إلى فريقنا — لوحة تحكم سوبر قيم";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="sk-auth-body">

    <div class="sk-auth-orb sk-auth-orb--primary"></div>
    <div class="sk-auth-orb sk-auth-orb--gold"></div>
    <div class="sk-auth-orb sk-auth-orb--cyan"></div>

    <div class="sk-auth-card" style="max-width: 520px;">
        <div class="sk-auth-logo-badge">🤝</div>
        <h1 class="sk-auth-title">انضم إلى فريق الإدارة</h1>
        <p class="sk-auth-subtitle">أرسل طلب الحصول على صلاحية الوصول للـ Admin Leader للمراجعة والاعتماد</p>

        @if (ViewData["WarningMessage"] != null)
        {
            <div class="alert alert-warning border-0 rounded-3 small mb-3" style="background: rgba(245, 158, 11, 0.16); color: #fcd34d;">
                @ViewData["WarningMessage"]
            </div>
        }

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 rounded-3 small mb-3" style="background: rgba(239, 68, 68, 0.16); color: #fca5a5;">
                @ViewData["ErrorMessage"]
            </div>
        }

        <form asp-controller="AdminAuth" asp-action="JoinTeam" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-bold small text-light">الاسم الكامل</label>
                <input asp-for="FullName" type="text" class="form-control sk-auth-input" placeholder="مثال: أحمد الدمراني" required />
                <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold small text-light">البريد الإلكتروني</label>
                <input asp-for="Email" type="email" class="form-control sk-auth-input" placeholder="member@example.com" dir="ltr" required />
                <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-bold small text-light">كلمة المرور</label>
                    <div class="sk-auth-input-group">
                        <input asp-for="Password" type="password" id="joinPassword" class="form-control sk-auth-input ps-5" placeholder="••••••••" dir="ltr" required />
                        <button type="button" class="sk-password-toggle" onclick="togglePass('joinPassword', this)">👁️</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold small text-light">تأكيد كلمة المرور</label>
                    <div class="sk-auth-input-group">
                        <input asp-for="ConfirmPassword" type="password" id="joinConfirmPassword" class="form-control sk-auth-input ps-5" placeholder="••••••••" dir="ltr" required />
                        <button type="button" class="sk-password-toggle" onclick="togglePass('joinConfirmPassword', this)">👁️</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                </div>
            </div>

            <button type="submit" class="sk-auth-submit-btn">
                📨 إرسال طلب الانضمام للـ Admin Leader
            </button>
        </form>

        <div class="sk-auth-join-box">
            <a asp-controller="AdminAuth" asp-action="Login" class="sk-auth-join-btn">
                🔙 العودة إلى صفحة تسجيل الدخول
            </a>
        </div>
    </div>

    <script>
        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }
    </script>
</body>
</html>

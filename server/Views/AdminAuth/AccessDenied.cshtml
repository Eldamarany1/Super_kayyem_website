@{
    ViewData["Title"] = "صلاحية مرفوضة";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : null;
}
@if (User.Identity?.IsAuthenticated != true)
{
    <!DOCTYPE html>
    <html lang="ar" dir="rtl" data-bs-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    </head>
    <body class="sk-auth-body">
        <div class="sk-auth-orb sk-auth-orb--primary"></div>
        <div class="sk-auth-orb sk-auth-orb--gold"></div>
        <div class="sk-auth-orb sk-auth-orb--cyan"></div>

        <div class="sk-auth-card text-center" style="max-width: 520px;">
            <div class="sk-auth-logo-badge">🛡️</div>
            <h2 class="sk-auth-title text-warning">منطقة محمية</h2>
            <p class="sk-auth-subtitle mb-4">
                صفحة إدارة المشرفين متاحة فقط لحساب قائد الفريق (SuperAdmin). يرجى تسجيل الدخول بحساب مصرح له.
            </p>
            <a asp-controller="AdminAuth" asp-action="Login" class="sk-auth-submit-btn text-decoration-none d-inline-block">
                🔐 تسجيل الدخول إلى اللوحة
            </a>
        </div>
    </body>
    </html>
}
else
{
    <div class="container py-5 text-center" dir="rtl">
        <div class="sk-card mx-auto p-5" style="max-width: 540px;">
            <div class="display-3 mb-3">🛡️</div>
            <h3 class="fw-bold text-warning mb-3">منطقة مخصصة لقائد الفريق فقط (Admin Leader)</h3>
            <p class="text-secondary mb-4">
                عذراً، صفحة إدارة طلبات الانضمام وصلاحيات المشرفين متاحة فقط لحساب الـ <strong>SuperAdmin</strong> الأساسي.
            </p>
            <a asp-controller="Admin" asp-action="Index" class="btn sk-btn-primary px-4 py-2">
                📚 العودة إلى إدارة القصص
            </a>
        </div>
    </div>
}

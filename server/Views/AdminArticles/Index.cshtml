@using System.Security.Claims
@model IEnumerable<SuperKayyem.Models.Article>

@{
    ViewData["Title"] = "إدارة مقالات توعية الآباء";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    string currentEmail = User.FindFirstValue(ClaimTypes.Email)?.Trim().ToLowerInvariant() ?? "";
    string currentName = User.Identity?.Name?.Trim().ToLowerInvariant() ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">📝 مقالات توعوية للآباء والمربين</h2>
        <p class="text-secondary mb-0">إدارة المقالات التربوية ونشرها مباشرة على منصة سوبر قيم (نص وصورة توضيحية بدون PDF)</p>
    </div>
    <a asp-controller="AdminArticles" asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
        <span>➕</span>
        <span>كتابة مقال جديد</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card bg-dark border-secondary border-opacity-25 p-3 p-md-4 rounded-4 shadow-sm">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-secondary">
            <div class="display-4 mb-3">📰</div>
            <h5>لا توجد مقالات منشورة حتى الآن</h5>
            <p class="small">ابدأ بإضافة أول مقال توعوي لأولياء الأمور والمربين.</p>
            <a asp-controller="AdminArticles" asp-action="Create" class="btn btn-primary mt-2">➕ إضافة مقال</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark text-secondary border-bottom border-secondary border-opacity-25">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th style="width: 90px;">الصورة</th>
                        <th>عنوان المقال</th>
                        <th>التصنيف</th>
                        <th>الناشر</th>
                        <th>تاريخ النشر</th>
                        <th class="text-center" style="width: 180px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isOwner = isSuperAdmin
                            || (!string.IsNullOrWhiteSpace(currentEmail) && !string.IsNullOrWhiteSpace(item.AuthorEmail) && string.Equals(item.AuthorEmail.Trim(), currentEmail, StringComparison.OrdinalIgnoreCase))
                            || (string.IsNullOrWhiteSpace(item.AuthorEmail) && !string.IsNullOrWhiteSpace(currentName) && !string.IsNullOrWhiteSpace(item.AuthorName) && string.Equals(item.AuthorName.Trim(), currentName, StringComparison.OrdinalIgnoreCase));

                        <tr>
                            <td class="fw-bold text-muted">#@item.Id</td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Title"
                                     style="width: 72px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15);" />
                            </td>
                            <td class="fw-bold text-light" style="max-width: 280px;">
                                @item.Title
                            </td>
                            <td>
                                <span class="badge bg-info text-dark fw-semibold">@item.Category</span>
                            </td>
                            <td>
                                <span class="text-warning small fw-semibold">✍️ @item.AuthorName</span>
                            </td>
                            <td class="text-secondary small">
                                @item.PublishedAt.ToString("yyyy-MM-dd")
                            </td>
                            <td class="text-center">
                                @if (isOwner)
                                {
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="AdminArticles" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info fw-bold px-3">
                                            تعديل
                                        </a>
                                        <a asp-controller="AdminArticles" asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger fw-bold px-3">
                                            حذف
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary px-3 py-2 border border-secondary border-opacity-25" title="لا يمكنك تعديل هذا المقال">
                                        🔒 بواسطة: @item.AuthorName
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

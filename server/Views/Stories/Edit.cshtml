@model SuperKayyem.Models.Story

@{
    ViewData["Title"] = $"تعديل القصة: {Model.Title}";
    string initialMode = !string.IsNullOrWhiteSpace(Model.PdfUrl) ? "pdf" : (Model.Pages != null && Model.Pages.Any() ? "editor" : "");
}

<div class="container-fluid py-2" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-light">تعديل القصة: @Model.Title</h2>
            <p class="text-secondary mb-0">تحديث البيانات والصفحات أو استبدال ملف الـ PDF</p>
        </div>
        <a asp-controller="Stories" asp-action="Index" class="btn btn-outline-secondary">إلغاء والعودة</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">
            <h6 class="fw-bold mb-2">يرجى تصحيح الأخطاء التالية قبل المتابعة:</h6>
            <div asp-validation-summary="All" class="text-danger small"></div>
        </div>
    }

    <form asp-controller="Stories" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="storyForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CoverImage" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="Rating" />

        <!-- 1. Basic Metadata Card -->
        <div class="card bg-dark border-secondary border-opacity-25 rounded-3 p-4 mb-4 shadow-sm">
            <h5 class="fw-bold text-light border-bottom border-secondary border-opacity-25 pb-3 mb-3">
                البيانات الأساسية للقصة
            </h5>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Title" class="form-label text-secondary small">عنوان القصة (إجباري)</label>
                    <input asp-for="Title" class="form-control bg-dark text-light border-secondary border-opacity-50" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="Category" class="form-label text-secondary small">الفئة (القيمة الأخلاقية)</label>
                    <select asp-for="Category" class="form-select bg-dark text-light border-secondary border-opacity-50" required>
                        <option value="">-- اختر القيمة --</option>
                        <option value="التعاون">التعاون</option>
                        <option value="الشجاعة">الشجاعة</option>
                        <option value="الصدق">الصدق</option>
                        <option value="المسؤولية">المسؤولية</option>
                        <option value="الصداقة">الصداقة</option>
                        <option value="الصبر">الصبر</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="TargetAge" class="form-label text-secondary small">العمر المستهدف (سنوات)</label>
                    <select asp-for="TargetAge" class="form-select bg-dark text-light border-secondary border-opacity-50" required>
                        <option value="">-- اختر الفئة العمرية --</option>
                        <option value="4">4 سنوات</option>
                        <option value="5">5 سنوات</option>
                        <option value="6">6 سنوات</option>
                        <option value="7">7 سنوات</option>
                        <option value="8">8 سنوات</option>
                        <option value="9">9 سنوات</option>
                        <option value="10">10 سنوات</option>
                        <option value="11">11 سنة</option>
                        <option value="12">12 سنة</option>
                    </select>
                    <span asp-validation-for="TargetAge" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Price" class="form-label text-secondary small">السعر (EGP)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-light border-secondary border-opacity-50" required />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label for="imageFile" class="form-label text-secondary small">صورة الغلاف الرئيسية</label>
                    @if (!string.IsNullOrEmpty(Model.CoverImage))
                    {
                        <div class="mb-2 d-flex align-items-center gap-2">
                            <img src="@Model.CoverImage" alt="الغلاف الحالي" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" />
                            <small class="text-secondary">الغلاف الحالي محفوظ</small>
                        </div>
                    }
                    <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control bg-dark text-light border-secondary border-opacity-50" />
                    <small class="text-secondary" style="font-size: 0.75rem;">اختر ملف جديد لاستبدال الغلاف الحالي.</small>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Slug" class="form-label text-secondary small">الرابط اللطيف (Slug)</label>
                    <input asp-for="Slug" dir="ltr" class="form-control bg-dark text-light border-secondary border-opacity-50" />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label text-secondary small">وصف القصة</label>
                    <textarea asp-for="Description" rows="3" class="form-control bg-dark text-light border-secondary border-opacity-50"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- 2. Mandatory Content Input Method Selector -->
        <div class="card bg-dark border-secondary border-opacity-25 rounded-3 p-4 mb-4 shadow-sm">
            <h5 class="fw-bold text-light border-bottom border-secondary border-opacity-25 pb-3 mb-3">
                طريقة إدخال محتوى القصة
            </h5>

            <div class="mb-3">
                <label for="storyContentMode" class="form-label text-warning fw-semibold">
                    طريقة إدخال محتوى القصة (إجباري)
                </label>
                <select id="storyContentMode" name="ContentMode" class="form-select bg-dark text-light border-secondary border-opacity-50" required>
                    <option value="">-- اختر طريقة إدخال القصة (إجباري) --</option>
                    <option value="pdf" selected="@(initialMode == "pdf")">رفع ملف القصة بصيغة PDF</option>
                    <option value="editor" selected="@(initialMode == "editor")">كتابة صفحات القصة يدوياً عبر محرر الصفحات</option>
                </select>
            </div>

            <!-- PDF Upload Slot (Strict Visibility) -->
            <div id="pdfSection" style="display: none;" class="mt-3 p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25">
                <label for="pdfFile" class="form-label text-info fw-semibold">ملف الـ PDF للقصة</label>
                @if (!string.IsNullOrEmpty(Model.PdfUrl))
                {
                    <div class="mb-2 p-2 bg-dark rounded border border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <span class="text-light small font-monospace" dir="ltr">@Model.PdfUrl</span>
                        <a href="@Model.PdfUrl" target="_blank" class="btn btn-sm btn-outline-info">معاينة الـ PDF الحالي</a>
                    </div>
                }
                <input type="file" name="pdfFile" id="pdfFile" accept=".pdf" class="form-control bg-dark text-light border-secondary border-opacity-50" />
                <div class="form-text text-secondary small mt-1">
                    اختر ملف PDF جديد إذا كنت ترغب في استبدال الملف الحالي.
                </div>
                <div class="mt-3">
                    <label asp-for="PageCount" class="form-label text-secondary small">عدد الصفحات التقديري</label>
                    <input asp-for="PageCount" type="number" min="1" class="form-control bg-dark text-light border-secondary border-opacity-50" style="max-width: 160px;" />
                </div>
            </div>

            <!-- Story Page Builder (Strict Visibility) -->
            <div id="editorSection" style="display: none;" class="mt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25">
                    <div>
                        <h6 class="fw-bold text-light mb-1">محرر صفحات القصة التفاعلي</h6>
                        <p class="text-secondary small mb-0">تعديل صفحات القصة، العناوين، الفواصل، الصور، والنصوص المقيدة بالسعة لمنع فيضان النص.</p>
                    </div>
                    <button type="button" id="addPageBtn" class="btn btn-sm btn-outline-warning fw-semibold px-3">
                        إضافة صفحة جديدة
                    </button>
                </div>

                <div id="pagesContainer" class="d-flex flex-column gap-3">
                    <!-- Dynamic Page Cards Appended Here -->
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-controller="Stories" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
            <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold">حفظ التعديلات</button>
        </div>
    </form>
</div>

<script>
    const SPEC_NOTE = "المواصفات القياسية لصورة الصفحة: الأبعاد المثالية 800×1000 بكسل (نسبة أبعاد 4:5 عمودي / Portrait) أو 800×420 بكسل لنصف الصفحة العلوي، لتطابق حجم صفحة الـ Flipbook، بصيغة PNG أو JPG أو WebP وبحجم أقصى 2MB.";

    const modeSelect = document.getElementById('storyContentMode');
    const pdfSection = document.getElementById('pdfSection');
    const editorSection = document.getElementById('editorSection');
    const pagesContainer = document.getElementById('pagesContainer');
    const addPageBtn = document.getElementById('addPageBtn');

    // Existing pages from server model
    const existingPages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pages ?? new List<SuperKayyem.Models.StoryPageItem>()));

    function updateVisibility() {
        const val = modeSelect.value;
        if (val === 'pdf') {
            pdfSection.style.display = 'block';
            editorSection.style.display = 'none';
            pdfSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = false);
            editorSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = true);
        } else if (val === 'editor') {
            pdfSection.style.display = 'none';
            editorSection.style.display = 'block';
            pdfSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = true);
            editorSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = false);
            if (pagesContainer.children.length === 0) {
                if (existingPages && existingPages.length > 0) {
                    existingPages.forEach(p => addPageCard(p));
                } else {
                    addPageCard();
                }
            }
        } else {
            pdfSection.style.display = 'none';
            editorSection.style.display = 'none';
            pdfSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = true);
            editorSection.querySelectorAll('input, select, textarea').forEach(el => el.disabled = true);
        }
    }

    modeSelect.addEventListener('change', updateVisibility);

    function addPageCard(existingData) {
        const index = pagesContainer.children.length;
        const pageNum = index + 1;

        const card = document.createElement('div');
        card.className = 'page-card card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 p-3';
        card.dataset.index = index;

        const headlineVal = existingData && existingData.Headline ? existingData.Headline : (existingData && existingData.headline ? existingData.headline : '');
        const hasSep = existingData && (existingData.HasSeparator === true || existingData.hasSeparator === true);
        const separatorChecked = hasSep ? 'checked' : '';
        const contentVal = existingData && existingData.Content ? existingData.Content : (existingData && existingData.content ? existingData.content : '');
        const imgUrlVal = existingData && existingData.IllustrationUrl ? existingData.IllustrationUrl : (existingData && existingData.illustrationUrl ? existingData.illustrationUrl : '');

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary page-title-badge">الصفحة ${pageNum}</span>
                    <span class="text-secondary small capacity-label">السعة القصوى: 280 حرف</span>
                </div>
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary move-up-btn" title="تحريك لأعلى">▲</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary move-down-btn" title="تحريك لأسفل">▼</button>
                    <button type="button" class="btn btn-sm btn-outline-danger delete-page-btn" title="حذف الصفحة">حذف</button>
                </div>
            </div>

            <input type="hidden" name="Pages[${index}].PageNum" value="${pageNum}" class="page-num-input" />
            <input type="hidden" name="Pages[${index}].IllustrationUrl" value="${imgUrlVal}" class="page-illustration-url" />

            <div class="row g-3">
                <div class="col-12 col-md-8">
                    <label class="form-label text-secondary small">عنوان فرعي للصفحة (اختياري)</label>
                    <input type="text" name="Pages[${index}].Headline" maxlength="60" class="form-control bg-dark text-light border-secondary border-opacity-50"
                           placeholder="عنوان فرعي يظهر أعلى الصفحة (اختياري)" value="${headlineVal}" />
                </div>
                <div class="col-12 col-md-4 d-flex align-items-center pt-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Pages[${index}].HasSeparator" value="true" id="sep_${index}" ${separatorChecked}>
                        <label class="form-check-label text-secondary small" for="sep_${index}">
                            إضافة خط فاصل أسفل العنوان الفرعي
                        </label>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label text-secondary small">صورة توضيحية للصفحة (اختياري)</label>
                    ${imgUrlVal ? `<div class="mb-2"><img src="${imgUrlVal}" alt="صورة الصفحة" style="max-height: 100px; border-radius: 6px;" /><span class="small text-secondary ms-2">صورة حالية</span></div>` : ''}
                    <input type="file" name="pageImage_${index}" data-page-index="${index}" accept="image/png,image/jpeg,image/webp"
                           class="form-control bg-dark text-light border-secondary border-opacity-50 page-image-input" />
                    <div class="text-secondary small mt-1" style="font-size: 0.76rem; line-height: 1.4;">
                        ${SPEC_NOTE}
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label text-secondary small mb-0">نص الصفحة (إجباري)</label>
                        <span class="char-counter small text-secondary">0 / 280 حرف</span>
                    </div>
                    <textarea name="Pages[${index}].Content" class="form-control bg-dark text-light border-secondary border-opacity-50 page-content-textarea"
                              required rows="4" maxlength="280">${contentVal}</textarea>
                </div>
            </div>
        `;

        pagesContainer.appendChild(card);
        bindPageCardEvents(card);
        reindexPages();
    }

    addPageBtn.addEventListener('click', function () {
        addPageCard();
    });

    function bindPageCardEvents(card) {
        const fileInput = card.querySelector('.page-image-input');
        const hiddenImgUrl = card.querySelector('.page-illustration-url');
        const textarea = card.querySelector('.page-content-textarea');
        const counter = card.querySelector('.char-counter');
        const capLabel = card.querySelector('.capacity-label');

        function updateCounter() {
            const hasImage = (fileInput.files && fileInput.files.length > 0) || (hiddenImgUrl && hiddenImgUrl.value.trim().length > 0);
            const maxChars = hasImage ? 160 : 280;
            textarea.setAttribute('maxlength', maxChars);

            if (textarea.value.length > maxChars) {
                textarea.value = textarea.value.substring(0, maxChars);
            }

            const current = textarea.value.length;
            counter.textContent = `${current} / ${maxChars} حرف`;
            capLabel.textContent = `السعة القصوى: ${maxChars} حرف`;

            if (current >= maxChars) {
                counter.classList.add('text-warning');
            } else {
                counter.classList.remove('text-warning');
            }
        }

        fileInput.addEventListener('change', updateCounter);
        textarea.addEventListener('input', updateCounter);
        updateCounter();

        card.querySelector('.delete-page-btn').addEventListener('click', function () {
            if (pagesContainer.children.length <= 1) {
                alert('يجب الإبقاء على صفحة واحدة على الأقل في محرر الصفحات.');
                return;
            }
            card.remove();
            reindexPages();
        });

        card.querySelector('.move-up-btn').addEventListener('click', function () {
            if (card.previousElementSibling) {
                pagesContainer.insertBefore(card, card.previousElementSibling);
                reindexPages();
            }
        });

        card.querySelector('.move-down-btn').addEventListener('click', function () {
            if (card.nextElementSibling) {
                pagesContainer.insertBefore(card, card.nextElementSibling, card);
                reindexPages();
            }
        });
    }

    function reindexPages() {
        const cards = pagesContainer.querySelectorAll('.page-card');
        cards.forEach((card, i) => {
            card.dataset.index = i;
            card.querySelector('.page-title-badge').textContent = `الصفحة ${i + 1}`;

            const numInput = card.querySelector('.page-num-input');
            numInput.name = `Pages[${i}].PageNum`;
            numInput.value = i + 1;

            const headlineInput = card.querySelector('input[name*="Headline"]');
            if (headlineInput) headlineInput.name = `Pages[${i}].Headline`;

            const sepCheckbox = card.querySelector('input[type="checkbox"]');
            if (sepCheckbox) {
                sepCheckbox.name = `Pages[${i}].HasSeparator`;
                sepCheckbox.id = `sep_${i}`;
                const label = card.querySelector('label[for*="sep_"]');
                if (label) label.htmlFor = `sep_${i}`;
            }

            const fileInput = card.querySelector('.page-image-input');
            if (fileInput) {
                fileInput.name = `pageImage_${i}`;
                fileInput.dataset.pageIndex = i;
            }

            const hiddenImg = card.querySelector('.page-illustration-url');
            if (hiddenImg) hiddenImg.name = `Pages[${i}].IllustrationUrl`;

            const textarea = card.querySelector('.page-content-textarea');
            if (textarea) textarea.name = `Pages[${i}].Content`;
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (existingPages && existingPages.length > 0 && pagesContainer.children.length === 0) {
            existingPages.forEach(p => addPageCard(p));
        }
        updateVisibility();
    });
</script>

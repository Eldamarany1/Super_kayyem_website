@* ============================================================
   Create.cshtml — نموذج إضافة قصة جديدة
   @model Story: البيانات القادمة من AdminController.Create() [GET]
   ستُرسَل إلى AdminController.Create(Story) [POST] عند الحفظ
   ============================================================ *@
@model Story
@{
    ViewData["Title"] = "إضافة قصة جديدة";
}

<div class="form-card">
    @* asp-action="Create": يُرسل النموذج إلى /Admin/Create بطريقة POST *@
    <form asp-action="Create" method="post">
        @* AntiForgeryToken: يضيف حقلاً مخفياً لحماية النموذج من هجمات CSRF
           يتوقع وجوده [ValidateAntiForgeryToken] في الـ Controller *@
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="form-group">
                @* asp-for="Title": يربط هذا الحقل بخاصية Title في نموذج Story
                   يولّد: name="Title" id="Title" value="..." تلقائياً *@
                <label asp-for="Title" class="form-label">العنوان</label>
                <input asp-for="Title" class="form-control" placeholder="عنوان القصة" required />
                @* asp-validation-for: يعرض رسالة الخطأ إذا فشل التحقق من الحقل *@
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Slug" class="form-label">الرابط (Slug)</label>
                @* dir="ltr": اتجاه الكتابة من اليسار لليمين لأن الـ Slug بالإنجليزية *@
                <input asp-for="Slug" class="form-control" dir="ltr" placeholder="story-slug" />
                <small class="form-hint">اتركه فارغاً للإنشاء التلقائي</small>
            </div>

            <div class="form-group">
                <label asp-for="Category" class="form-label">الفئة (القيمة الأخلاقية)</label>
                @* asp-for على select: يحدد الخيار المُختار تلقائياً إذا كانت القيمة موجودة في الـ Model *@
                <select asp-for="Category" class="form-select" required>
                    <option value="">اختر الفئة...</option>
                    <option value="التعاون">التعاون</option>
                    <option value="الشجاعة">الشجاعة</option>
                    <option value="الصدق">الصدق</option>
                    <option value="المسؤولية">المسؤولية</option>
                    <option value="الصداقة">الصداقة</option>
                    <option value="الصبر">الصبر</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TargetAgeGroup" class="form-label">الفئة العمرية</label>
                <input asp-for="TargetAgeGroup" class="form-control" placeholder="مثال: 6-8 سنوات" required />
                <span asp-validation-for="TargetAgeGroup" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="form-label">السعر (EGP)</label>
                @* type="number" step="0.01": يسمح بإدخال أرقام عشرية مثل 35.50 *@
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Rating" class="form-label">التقييم (0-5)</label>
                @* min="0" max="5": يحدد الحد الأدنى والأقصى للتقييم *@
                <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" placeholder="4.5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PageCount" class="form-label">عدد الصفحات</label>
                <input asp-for="PageCount" type="number" class="form-control" placeholder="20" />
                <span asp-validation-for="PageCount" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CoverImage" class="form-label">رابط صورة الغلاف</label>
                <input asp-for="CoverImage" class="form-control" dir="ltr" placeholder="https://example.com/cover.jpg" />
                <span asp-validation-for="CoverImage" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group form-group-full">
            <label asp-for="Description" class="form-label">الوصف</label>
            @* textarea: حقل نص متعدد الأسطر — rows="4": يحدد ارتفاعه *@
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف القصة..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-actions">
            @* type="submit": يُرسل النموذج عند الضغط عليه *@
            <button type="submit" class="btn-admin btn-admin-primary">💾 حفظ القصة</button>
            @* asp-action="Index": رابط للعودة إلى صفحة القائمة بدون حفظ *@
            <a asp-action="Index" class="btn-admin btn-admin-secondary">↩ إلغاء</a>
        </div>
    </form>
</div>

@* section Scripts: منطقة خاصة لتحميل JavaScript إضافي في نهاية الصفحة
   _ValidationScriptsPartial: يُحمّل سكريبتات التحقق الفوري من صحة الحقول (jQuery Validation) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@* ============================================================
   Create.cshtml — Form to create a new story
   @model Story: Data passed from AdminController.Create() [GET]
   Sent to AdminController.Create(Story, IFormFile?, IFormFile?) [POST] on submit
   ============================================================ *@
@model Story
@{
    ViewData["Title"] = "إضافة قصة جديدة";
}

<div class="form-card">
    @* asp-action="Create": submits the form to /Admin/Create via POST
       enctype="multipart/form-data": required for file uploads *@
    <form asp-action="Create" asp-controller="Admin" method="post" enctype="multipart/form-data">
        @* AntiForgeryToken: adds a hidden field to protect against CSRF attacks
           Expected by [ValidateAntiForgeryToken] in the Controller *@
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="form-group">
                @* asp-for="Title": binds this input to Title in the Story model
                   Generates: name="Title" id="Title" value="..." automatically *@
                <label asp-for="Title" class="form-label">العنوان</label>
                <input asp-for="Title" class="form-control" placeholder="عنوان القصة" required />
                @* asp-validation-for: displays error message if validation fails *@
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Category" class="form-label">الفئة (القيمة الأخلاقية)</label>
                @* asp-for on select: selects the option matching the Model value *@
                <select asp-for="Category" class="form-select" required>
                    <option value="">اختر الفئة...</option>
                    <option value="التعاون">التعاون</option>
                    <option value="الشجاعة">الشجاعة</option>
                    <option value="الصدق">الصدق</option>
                    <option value="المسؤولية">المسؤولية</option>
                    <option value="الصداقة">الصداقة</option>
                    <option value="الصبر">الصبر</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TargetAge" class="form-label">العمر المستهدف (سنوات)</label>
                <select asp-for="TargetAge" class="form-select" required>
                    <option value="">اختر الفئة العمرية...</option>
                    <option value="4">4 سنوات</option>
                    <option value="5">5 سنوات</option>
                    <option value="6">6 سنوات</option>
                    <option value="7">7 سنوات</option>
                    <option value="8">8 سنوات</option>
                    <option value="9">9 سنوات</option>
                    <option value="10">10 سنوات</option>
                    <option value="11">11 سنة</option>
                    <option value="12">12 سنة</option>
                </select>
                <span asp-validation-for="TargetAge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="form-label">السعر (EGP)</label>
                @* type="number" step="0.01": allows decimal numbers like 35.50 *@
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            @* File upload for cover image — name must match IFormFile parameter name in controller *@
            <div class="form-group">
                <label for="imageFile" class="form-label">صورة الغلاف</label>
                <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control" />
                <small class="form-hint">سيتم رفع الصورة تلقائياً إلى Cloudinary.</small>
            </div>

            @* File upload for PDF — name must match IFormFile parameter name in controller *@
            <div class="form-group">
                <label for="pdfFile" class="form-label">ملف القصة الإلكتروني (PDF)</label>
                <input type="file" name="pdfFile" id="pdfFile" accept=".pdf" class="form-control" />
                <small class="form-hint">ملف الـ PDF الكامل للقصة ليتمكن الأطفال من قراءته أو تحميله.</small>
            </div>

            <div class="form-group">
                <label asp-for="PageCount" class="form-label">عدد الصفحات</label>
                <input asp-for="PageCount" type="number" class="form-control" placeholder="20" />
                <span asp-validation-for="PageCount" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group form-group-full">
            <label asp-for="Description" class="form-label">الوصف</label>
            @* textarea: multi-line text input — rows="4": sets input height *@
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف القصة..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-actions">
            @* type="submit": submits the form when clicked *@
            <button type="submit" class="btn-admin btn-admin-primary">💾 حفظ القصة</button>
            @* asp-action="Index": link to return to the list page without saving *@
            <a asp-action="Index" class="btn-admin btn-admin-secondary">↩ إلغاء</a>
        </div>
    </form>
</div>

@* section Scripts: special section to render page scripts at the bottom of the layout
   _ValidationScriptsPartial: loads client-side validation scripts (jQuery Validation) *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@* ============================================================
   Delete.cshtml — Story delete confirmation page
   @model Story: The story to delete passed from AdminController.Delete(int id) [GET]
   Clicking delete submits a POST form to AdminController.DeleteConfirmed(int id)
   ============================================================ *@
@model Story
@{
    ViewData["Title"] = $"حذف: {Model.Title}";
}

<div class="delete-card">
    <div class="delete-warning">
        <span class="warning-icon">⚠️</span>
        <h2>هل أنت متأكد من حذف هذه القصة؟</h2>
        <p>لا يمكن التراجع عن هذا الإجراء.</p>
    </div>

    @* Display story summary before confirming deletion *@
    <div class="detail-grid">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        {
            <div class="detail-item">
                <label>صورة الغلاف</label>
                <span><img src="@Model.CoverImage" alt="@Model.Title" style="max-width: 120px; max-height: 120px; border-radius: 8px;" /></span>
            </div>
        }
        <div class="detail-item">
            <label>العنوان</label>
            <span>@Model.Title</span>
        </div>
        <div class="detail-item">
            <label>الفئة</label>
            <span class="category-badge">@Model.Category</span>
        </div>
        <div class="detail-item">
            <label>الفئة العمرية</label>
            <span>@(Model.TargetAge.HasValue ? $"{Model.TargetAge.Value} سنوات" : "—")</span>
        </div>
        <div class="detail-item">
            <label>السعر</label>
            <span>@Model.Price.ToString("F0") EGP</span>
        </div>
        <div class="detail-item">
            <label>التقييم</label>
            @if (Model.Rating.HasValue)
            {
                <span>⭐ @Model.Rating.Value.ToString("F1")</span>
            }
            else
            {
                <span style="opacity: 0.5;">—</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.PdfUrl))
        {
            <div class="detail-item">
                <label>ملف PDF</label>
                <span><a href="@Model.PdfUrl" target="_blank">📄 عرض الـ PDF</a></span>
            </div>
        }
    </div>

    @* asp-action="Delete" with method="post": calls DeleteConfirmed in the Controller
       because [ActionName("Delete")] on DeleteConfirmed handles POST /Admin/Delete *@
    <form asp-action="Delete" method="post">
        @* AntiForgeryToken: required protection for delete and edit forms *@
        @Html.AntiForgeryToken()
        <div class="delete-actions">
            <button type="submit" class="btn-admin btn-admin-danger">🗑️ نعم، احذف القصة</button>
            @* This link does not submit the form — simple safe return link *@
            <a asp-action="Index" class="btn-admin btn-admin-secondary">↩ إلغاء</a>
        </div>
    </form>
</div>

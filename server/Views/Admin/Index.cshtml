@* ============================================================
   Index.cshtml — لوحة تحكم إدارة القصص
   @model: يحدد نوع البيانات القادمة من AdminController.Index()
   IEnumerable<Story>: قائمة قصص يمكن تكرارها (foreach)
   ============================================================ *@
@model IEnumerable<Story>
@{
    @* ViewData["Title"]: يُحدد عنوان الصفحة الذي يظهر في تاب المتصفح *@
    ViewData["Title"] = "إدارة القصص";
}

<div class="dashboard-stats">
    <div class="stat-card">
        @* @Model.Count(): عدد القصص في القائمة — @ يشغّل كود C# داخل HTML *@
        <div class="stat-number">@Model.Count()</div>
        <div class="stat-label">إجمالي القصص</div>
    </div>
    <div class="stat-card">
        @* .Select(s => s.Category): يستخرج فقط عمود Category من كل قصة
           .Distinct(): يحذف التكرارات — .Count(): يعد الفريدة منها *@
        <div class="stat-number">@Model.Select(s => s.Category).Distinct().Count()</div>
        <div class="stat-label">الفئات</div>
    </div>
    <div class="stat-card">
        @* .Average(): يحسب متوسط التقييم — مضمون عدم الانهيار لأن AdminController يبذر البيانات إذا كانت القائمة فارغة
           .ToString("F1"): يعرض رقماً عشرياً بمنزلة واحدة مثل "4.8" *@
        <div class="stat-number">@Model.Average(s => s.Rating).ToString("F1")</div>
        <div class="stat-label">متوسط التقييم</div>
    </div>
</div>

<div class="section-header">
    <h2>القصص</h2>
    @* asp-action="Create": Tag Helper يولّد رابط /Admin/Create تلقائياً *@
    <a asp-action="Create" class="btn-admin btn-admin-primary">
        ➕ إضافة قصة جديدة
    </a>
</div>

<div class="table-responsive">
    <table class="admin-table">
        <thead>
            <tr>
                <th>#</th>
                <th>العنوان</th>
                <th>الفئة</th>
                <th>الفئة العمرية</th>
                <th>السعر (EGP)</th>
                <th>التقييم</th>
                <th>الصفحات</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @* foreach: يكرر نفس HTML لكل قصة في القائمة *@
            @foreach (var story in Model)
            {
                <tr>
                    <td>@story.Id</td>
                    <td class="story-title-cell">
                        @* عرض صورة الغلاف فقط إذا كانت موجودة — تجنب عنصر <img> فارغ *@
                        @if (!string.IsNullOrEmpty(story.CoverImage))
                        {
                            <img src="@story.CoverImage" alt="" class="story-thumb" />
                        }
                        <span>@story.Title</span>
                    </td>
                    <td><span class="category-badge">@story.Category</span></td>
                    <td>@story.TargetAgeGroup</td>
                    @* .ToString("F0"): يعرض السعر بدون أرقام عشرية مثل "35" *@
                    <td>@story.Price.ToString("F0")</td>
                    <td>
                        <span class="rating-display">⭐ @story.Rating.ToString("F1")</span>
                    </td>
                    <td>@story.PageCount</td>
                    <td class="actions-cell">
                        @* asp-route-id: يمرر Id القصة كجزء من الـ URL مثل /Admin/Details/3 *@
                        <a asp-action="Details" asp-route-id="@story.Id" class="btn-action btn-view" title="عرض">👁</a>
                        <a asp-action="Edit" asp-route-id="@story.Id" class="btn-action btn-edit" title="تعديل">✏️</a>
                        <a asp-action="Delete" asp-route-id="@story.Id" class="btn-action btn-delete" title="حذف">🗑️</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* هذه الصفحة تظهر تلقائياً عند حدوث خطأ غير متوقع في التطبيق *@
@* النموذج (Model) هو كلاس ErrorViewModel الذي يحمل معلومات الخطأ *@
@model ErrorViewModel
@{
    @* تعيين عنوان التبويب في المتصفح *@
    ViewData["Title"] = "خطأ";
}

<div class="error-card">
    <h1>⚠️ حدث خطأ</h1>
    <p>حدث خطأ أثناء معالجة طلبك.</p>
    @* ShowRequestId = true تعني: اعرض معرّف الطلب الذي يساعد في تتبع الخطأ للمطور *@
    @* ?? false يعني: إذا كان Model فارغاً (null) استخدم القيمة false افتراضياً *@
    @if (Model?.ShowRequestId ?? false)
    {
        @* Model! — علامة ! تُخبر المترجم أن Model ليس null هنا (نحن متأكدون بعد الشرط أعلاه) *@
        <p><strong>معرّف الطلب:</strong> <code>@Model!.RequestId</code></p>
    }
    @* asp-controller و asp-action = Tag Helpers تُنشئ رابط HTML يوجه المستخدم إلى الصفحة الرئيسية *@
    <a asp-controller="Admin" asp-action="Index" class="btn-admin btn-admin-primary">↩ العودة للوحة التحكم</a>
</div>

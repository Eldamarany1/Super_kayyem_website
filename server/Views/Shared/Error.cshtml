@* This page appears automatically when an unexpected error occurs in the application *@
@* The Model is ErrorViewModel, which carries error details *@
@model ErrorViewModel
@{
    @* Set page title in the browser tab *@
    ViewData["Title"] = "خطأ";
}

<div class="error-card">
    <h1>⚠️ حدث خطأ</h1>
    <p>حدث خطأ أثناء معالجة طلبك.</p>
    @* ShowRequestId = true means: display the request ID to help the developer track the issue *@
    @* ?? false means: if Model is null, use false as default *@
    @if (Model?.ShowRequestId ?? false)
    {
        @* Model! — the ! null-forgiving operator tells the compiler Model is not null here *@
        <p><strong>معرّف الطلب:</strong> <code>@Model!.RequestId</code></p>
    }
    @* asp-controller and asp-action = Tag Helpers that generate an HTML link to the admin dashboard *@
    <a asp-controller="Admin" asp-action="Index" class="btn-admin btn-admin-primary">↩ العودة للوحة التحكم</a>
</div>

<!DOCTYPE html>
@* Shared layout file used by all admin dashboard views *@
@* Contains: Sidebar + Header + Main content area *@
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* @ViewData["Title"] = retrieved from each view via ViewData["Title"] = "..." at the top of the page *@
    <title>@ViewData["Title"] - سوبر قيّم | لوحة التحكم</title>
    @* Cairo Arabic font from Google Fonts to enhance Arabic text appearance *@
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    @* Bootstrap RTL (Right-to-Left) = Bootstrap version designed for right-to-left languages *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    @* Custom CSS file for the admin dashboard — asp-append-version adds a version hash to prevent caching *@
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon">📚</span>
                <span class="brand-text">سوبر قيّم</span>
            </div>
            <nav class="sidebar-nav">
                @* @Url.Action("Index", "Admin") = generates /Admin/Index URL dynamically *@
                @* ViewContext.RouteData.Values["action"] = reads current action name to highlight active link *@
                <a href="@Url.Action("Index", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <span class="link-icon">🏠</span>
                    <span>لوحة التحكم</span>
                </a>
                <a href="@Url.Action("AccountList", "Account")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AccountList" ? "active" : "")">
                    <span>عرض حسابات العملاء</span>
                </a>
                <a href="@Url.Action("Create", "Admin")" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                    <span class="link-icon">➕</span>
                    <span>إضافة قصة</span>
                </a>
            </nav>
            <div class="sidebar-footer">
                @* @DateTime.Now.Year = displays the current year automatically without manual updates *@
                <small>© @DateTime.Now.Year سوبر قيّم</small>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <header class="admin-header">
                @* Menu button displayed only on small screens (d-lg-none = hidden on large screens) *@
                @* onclick toggles "show" class on sidebar to show or hide it *@
                <button class="sidebar-toggle d-lg-none" onclick="document.querySelector('.admin-sidebar').classList.toggle('show')">
                    ☰
                </button>
                @* Page title set in ViewData["Title"] appears here in the header *@
                <h1 class="header-title">@ViewData["Title"]</h1>
            </header>
            <main class="admin-content">
                @* @RenderBody() = renders the content of each child .cshtml view — core of the layout *@
                @* Each view puts its content here automatically without rewriting the header or sidebar *@
                @RenderBody()
            </main>
        </div>
    </div>

    @* Bootstrap JS library with Popper (for modals and dropdowns) *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* Custom JS file for the admin dashboard *@
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @* @await RenderSectionAsync("Scripts", required: false) = renders optional page scripts defined in child views *@
    @* Child views declare them using @section Scripts { ... } — required: false means optional *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

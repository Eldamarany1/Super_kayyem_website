@* This partial view is included at the end of pages with forms that need input validation *@
@* jquery.validate = validates form fields on the client before submit (e.g. required field, valid email) *@
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
@* jquery.validate.unobtrusive = connects jQuery validation to asp-validation-for attributes generated by ASP.NET *@
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

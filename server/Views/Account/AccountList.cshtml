@* This page displays the list of all customers with statistics and children details *@
@* The Model is IEnumerable<Account> — can be iterated using foreach *@
@model IEnumerable<SuperKayyem.Models.Account>

@{
    ViewData["Title"] = "إدارة العملاء والأطفال";
    @* Model?.Count() = number of customers — the ? protects against null references *@
    var totalAccounts = Model?.Count() ?? 0;
    @* Sum(...) = sum of children across all accounts — lambda expression: a => a.Children?.Count ?? 0 *@
    var totalChildren = Model?.Sum(a => a.Children?.Count ?? 0) ?? 0;
    @* Calculate average — (int) casts to integer, ToString("0") formats without decimals *@
    var avgChildren = totalAccounts > 0 ? ((int)totalChildren / totalAccounts).ToString("0") : "0";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 bg-dark min-vh-100" data-bs-theme="dark" dir="rtl">

    <!-- 1. Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 text-center py-4 shadow-sm h-100">
                <div class="card-body p-0">
                    @* @totalAccounts = displays the local variable computed at the top of the view *@
                    <div class="display-6 fw-bold text-info mb-1">@totalAccounts</div>
                    <div class="text-secondary small fw-semibold">إجمالي العملاء</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 text-center py-4 shadow-sm h-100">
                <div class="card-body p-0">
                    <div class="display-6 fw-bold text-info mb-1">@totalChildren</div>
                    <div class="text-secondary small fw-semibold">إجمالي الأطفال</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 text-center py-4 shadow-sm h-100">
                <div class="card-body p-0">
                    <div class="display-6 fw-bold text-info mb-1">@avgChildren</div>
                    <div class="text-secondary small fw-semibold">متوسط الأطفال لكل عميل</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Header and Add button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-white mb-0">قائمة العملاء</h3>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold rounded-3 shadow-sm">
            <i class="bi bi-plus-circle"></i>
            <span>إضافة عميل جديد</span>
        </a>
    </div>

    <!-- 3. Data Table -->
    <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 text-end">
                <thead class="table-active border-bottom border-secondary border-opacity-25">
                    <tr class="text-secondary small">
                        <th scope="col" class="py-3 px-3 text-center" style="width: 50px;">#</th>
                        <th scope="col" class="py-3 px-3 text-start">اسم العميل</th>
                        <th scope="col" class="py-3 px-3 text-start">البريد الإلكتروني</th>
                        <th scope="col" class="py-3 px-3 text-start">النوع</th>
                        <th scope="col" class="py-3 px-3 text-start">تاريخ الميلاد</th>
                        <th scope="col" class="py-3 px-3 text-start">الأطفال المسجلين</th>
                        <th scope="col" class="py-3 px-3 text-center" style="width: 150px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @* Verify that the collection is not empty before rendering *@
                    @if (Model != null && Model.Any())
                    {
                        @* Counter variable to number rows — incremented at the end of each iteration *@
                        int index = 1;
                        foreach (var account in Model)
                        {
                            @* Generate unique collapse ID for each row to toggle children details via Bootstrap Collapse *@
                            @* $"..." = String Interpolation — combines account.Id into text to ensure unique ID *@
                            var collapseId = $"children-details-{account.Id}";
                            <tr>
                                <!-- Row number -->
                                <td class="text-center text-secondary fw-semibold py-3">@index</td>

                                <!-- Customer name and avatar -->
                                <td class="py-3 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-2 bg-secondary bg-opacity-25 text-info d-flex align-items-center justify-content-center p-2" style="width: 38px; height: 38px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                        <span class="fw-bold text-light">@account.FirstName @account.LastName</span>
                                    </div>
                                </td>

                                <!-- Email -->
                                <td class="py-3 px-3 text-secondary">@account.Email</td>

                                <!-- Gender -->
                                <td class="py-3 px-3 text-center">
                                    @* @(...) = Razor expression in parentheses because it contains a ternary operator ? : *@
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 fw-semibold">
                                        @(account.Gender == "Male" || account.Gender == "ذكر" ? "ذكر" : "أنثى")
                                    </span>
                                </td>

                                <!-- Date of birth and age -->
                                <td class="py-3 px-3 text-light">
                                    @* ToString("yyyy/MM/dd") = formats the date for display *@
                                    @account.DateOfBirth.ToString("yyyy/MM/dd")
                                    <small class="text-secondary ms-1">
                                        @* Calculate age by subtracting birth year from current year *@
                                        (@((DateTime.Now.Year - account.DateOfBirth.Year)) سنة)
                                    </small>
                                </td>

                                <!-- Registered children -->
                                <td class="py-3 px-3">
                                    @if (account.Children != null && account.Children.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            @* .Take(2) = displays only the first two children; remaining are in collapse dropdown *@
                                            @foreach (var child in account.Children.Take(2))
                                            {
                                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 d-inline-flex align-items-center gap-1">
                                                    @* Set gender icon based on child Gender property *@
                                                    <i class="bi @(child.Gender == "Female" || child.Gender == "أنثى" ? "bi-gender-female" : "bi-gender-male")"></i>
                                                    @child.Name (@child.Age س)
                                                </span>
                                            }
                                            @* If customer has more than 2 children, show a "+X more" button *@
                                            @if (account.Children.Count > 2)
                                            {
                                                @* data-bs-toggle="collapse" = Bootstrap attribute to toggle target section *@
                                                @* data-bs-target="#@collapseId" = targets the hidden collapse row below *@
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill small"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#@collapseId"
                                                        aria-expanded="false">
                                                    @* @(...) required here because the expression contains subtraction - *@
                                                    +@(account.Children.Count - 2) المزيد
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">لا يوجد أطفال</span>
                                    }
                                </td>

                                <!-- Action buttons -->
                                <td class="py-3 px-3 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- View button -->
                                        @* asp-action="Read" asp-route-id="@account.Id" = generates link like /Account/Read/5 *@
                                        <a asp-action="Read" asp-route-id="@account.Id"
                                           class="btn btn-sm bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-2 p-1 px-2"
                                           title="عرض">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Edit button -->
                                        <a asp-action="Update" asp-route-id="@account.Id"
                                           class="btn btn-sm bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-2 p-1 px-2"
                                           title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete button -->
                                        <a asp-action="Delete" asp-route-id="@account.Id"
                                           class="btn btn-sm bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-2 p-1 px-2"
                                           title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <!-- Collapsible row to show all children -->
                            @* Hidden by default (class="collapse") and toggled via data-bs-target *@
                            @* id="@collapseId" links this row to the target button *@
                            @if (account.Children != null && account.Children.Count > 2)
                            {
                                <tr class="collapse" id="@collapseId">
                                    @* colspan="7" spans the cell across all 7 columns *@
                                    <td colspan="7" class="bg-black bg-opacity-25 px-4 py-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <small class="text-secondary fw-semibold">جميع أطفال العميل:</small>
                                            <div class="d-flex flex-wrap gap-2">
                                                @* Render all children without limit — no .Take() *@
                                                @foreach (var child in account.Children)
                                                {
                                                    @* ?? "Unspecified" = fallback text if Gender is null *@
                                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-50 px-2 py-1">
                                                        @child.Name | @child.Age سنة | @(child.Gender ?? "غير محدد")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @* Increment counter after each row *@
                            index++;
                        }
                    }
                    else
                    {
                        @* Message shown when database collection is empty *@
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                لا توجد حسابات عملاء مسجلة حالياً
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
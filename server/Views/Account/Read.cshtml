@* This page displays details of a single customer account, including profile and children data *@
@* The Model is an Account object carrying full account details *@
@model SuperKayyem.Models.Account

@{
    @* Page title includes customer name *@
    ViewData["Title"] = $"تفاصيل العميل: {Model.FirstName} {Model.LastName}";
    @* Calculate customer age by subtracting birth year from current year *@
    var clientAge = DateTime.Now.Year - Model.DateOfBirth.Year;
    @* Children count — ?? 0 prevents error if collection is null *@
    var childrenCount = Model.Children?.Count ?? 0;
}

<!-- Import Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 bg-dark min-vh-100" data-bs-theme="dark" dir="rtl">
    <div class="container">

        <!-- 1. Header and Actions -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <!-- Breadcrumb navigation -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        @* asp-action="Index" = generates link to customers main page *@
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary text-decoration-none">العملاء</a></li>
                        <li class="breadcrumb-item active text-info" aria-current="page">تفاصيل الحساب</li>
                    </ol>
                </nav>
                <h3 class="fw-bold text-white mb-0">بيانات العميل: @Model.FirstName @Model.LastName</h3>
            </div>

            <!-- Action buttons and Back link -->
            <div class="d-flex gap-2">
                <a asp-action="AccountList" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3">
                    <i class="bi bi-arrow-right"></i>
                    <span>العودة للقائمة</span>
                </a>
                @* asp-route-id="@Model.Id" = appends route id (e.g. /5) to specify which account to edit *@
                <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold rounded-3 text-dark">
                    <i class="bi bi-pencil-square"></i>
                    <span>تعديل البيانات</span>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger bg-opacity-25 text-black border border-danger border-opacity-50 d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3">
                    <i class="bi bi-trash"></i>
                    <span>حذف</span>
                </a>
            </div>
        </div>

        <div class="row g-4">

            <!-- 2. Profile card and basic data (Right column in RTL) -->
            <div class="col-12 col-lg-4">

                <!-- Quick summary card -->
                <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 text-center p-4 shadow-sm mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FirstName" class="rounded-circle border border-info border-opacity-50 object-fit-cover mx-auto mb-3 shadow" style="width: 80px; height: 80px;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary bg-opacity-25 text-info d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-circle display-4"></i>
                        </div>
                    }
                    <h5 class="fw-bold text-white mb-1">@Model.FirstName @Model.LastName</h5>
                    <p class="text-secondary small mb-3">@Model.Email</p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @* @(...) required because the expression contains logical OR || and ternary operator ? : *@
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2">
                            الجنس: @(Model.Gender == "Male" || Model.Gender == "ذكر" ? "ذكر" : "أنثى")
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2">
                            العمر: @clientAge سنة
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                            قصص ممتلكة: @(Model.OwnedStoryIds?.Count ?? 0)
                        </span>
                    </div>
                </div>

                <!-- Children summary card -->
                <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 p-4 shadow-sm">
                    <h6 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart text-info"></i>
                        <span>ملخص الأطفال المسجلين</span>
                    </h6>
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-secondary d-flex justify-content-between px-0 border-secondary border-opacity-25">
                            <span>إجمالي الأطفال:</span>
                            <span class="fw-bold text-white">@childrenCount</span>
                        </li>
                        <li class="list-group-item bg-transparent text-secondary d-flex justify-content-between px-0 border-secondary border-opacity-25">
                            <span>الذكور:</span>
                            @* Count(c => ...) = LINQ method counting elements that match the condition *@
                            <span class="fw-bold text-info">@(Model.Children?.Count(c => c.Gender == "ذكر" || c.Gender == "Male") ?? 0)</span>
                        </li>
                        <li class="list-group-item bg-transparent text-secondary d-flex justify-content-between px-0 border-0">
                            <span>الإناث:</span>
                            <span class="fw-bold text-danger">@(Model.Children?.Count(c => c.Gender == "أنثى" || c.Gender == "Female") ?? 0)</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- 3. Detailed Information and Children List (Left column in RTL) -->
            <div class="col-12 col-lg-8">

                <!-- Personal account details -->
                <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 p-4 shadow-sm mb-4">
                    <h5 class="fw-bold text-white mb-4 d-flex align-items-center gap-2 border-bottom border-secondary border-opacity-25 pb-3">
                        <i class="bi bi-person-lines-fill text-info"></i>
                        <span>المعلومات الشخصية</span>
                    </h5>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">الاسم الأول</label>
                            <div class="fw-semibold text-light">@Model.FirstName</div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">اسم العائلة</label>
                            <div class="fw-semibold text-light">@Model.LastName</div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">البريد الإلكتروني</label>
                            <div class="fw-semibold text-light">@Model.Email</div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">تاريخ الميلاد</label>
                            <div class="fw-semibold text-light">
                                @* ToString("yyyy/MM/dd") = formats date for clear display *@
                                @Model.DateOfBirth.ToString("yyyy/MM/dd")
                                <small class="text-secondary ms-1">(@clientAge عاماً)</small>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">النوع / الجنس</label>
                            <div class="fw-semibold text-light">@Model.Gender</div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">معرّف الحساب (ID)</label>
                            <div class="fw-semibold text-secondary">#@Model.Id</div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="text-secondary small d-block mb-1">كلمة المرور</label>
                            <div class="d-flex align-items-center gap-2">
                                <span id="cust-pass-read" class="fw-semibold text-light font-monospace">••••••••</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        onclick="toggleReadPass('@Model.Password', this)">
                                    عرض
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer children details -->
                <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-25 pb-3 mb-3">
                        <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-book-half text-info"></i>
                            <span>أطفال العميل والفئات العمرية</span>
                        </h5>
                        <span class="badge bg-secondary bg-opacity-25 text-info px-3 py-2 rounded-pill">
                            @childrenCount أطفال
                        </span>
                    </div>

                    @if (Model.Children != null && Model.Children.Any())
                    {
                        <div class="row g-3">
                            @foreach (var child in Model.Children)
                            {
                                @* Razor local variable inside foreach — computed once per child *@
                                @* Used to select gender-appropriate styling and icons *@
                                var isFemale = child.Gender == "Female" || child.Gender == "أنثى";

                                <div class="col-12 col-md-6">
                                    <div class="card bg-dark bg-opacity-50 border-secondary border-opacity-25 rounded-3 p-3 h-100">
                                        <div class="d-flex align-items-center gap-3">
                                            <!-- Child icon by gender -->
                                            @* @(isFemale ? "..." : "...") = ternary operator to select CSS class based on gender *@
                                            <div class="rounded-3 @(isFemale ? "bg-danger bg-opacity-10 text-danger border-danger" : "bg-info bg-opacity-10 text-info border-info") border border-opacity-25 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                @* Different icon for boy and girl *@
                                                <i class="bi @(isFemale ? "bi-person-heart" : "bi-emoji-smile") fs-4"></i>
                                            </div>

                                            <!-- Child details -->
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="fw-bold text-light mb-0">@child.Name</h6>
                                                    @* ?? "Unspecified" = fallback text if Gender is null *@
                                                    <span class="badge @(isFemale ? "bg-danger bg-opacity-10 text-danger border-danger" : "bg-info bg-opacity-10 text-info border-info") border border-opacity-25 rounded-pill px-2 py-1 small">
                                                        @(child.Gender ?? "غير محدد")
                                                    </span>
                                                </div>
                                                <div class="text-secondary small d-flex align-items-center gap-2">
                                                    <span>العمر: <strong class="text-white">@child.Age</strong> سنوات</span>
                                                    <span>•</span>
                                                    <!-- Suggested story age group for the child -->
                                                    @* Nested ternary operator: age <= 6 shows "4-6", <= 8 shows "6-8", otherwise "8-10" *@
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                                        مناسب لقصص (@(child.Age <= 6 ? "4-6" : child.Age <= 8 ? "6-8" : "8-10") سنوات)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-secondary">
                            <i class="bi bi-people fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            لم يتم إضافة أي أطفال في هذا الحساب حتى الآن.
                        </div>
                    }
                </div>

                <!-- Story Purchases Card -->
                <div class="card bg-secondary bg-opacity-10 border-secondary border-opacity-25 rounded-3 p-4 shadow-sm mb-4">
                    <h5 class="fw-bold text-white mb-3 d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-bag-check text-warning"></i>
                            <span>سجل مشتريات القصص</span>
                        </span>
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                            @(Model.PurchasedStories?.Count ?? 0) قصة
                        </span>
                    </h5>

                    @if (Model.PurchasedStories != null && Model.PurchasedStories.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="table-dark text-secondary small border-bottom border-secondary border-opacity-25">
                                    <tr>
                                        <th>#</th>
                                        <th>عنوان القصة</th>
                                        <th>السعر المدفوع</th>
                                        <th>تاريخ الشراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchase in Model.PurchasedStories.OrderByDescending(p => p.PurchasedAt))
                                    {
                                        <tr>
                                            <td class="text-secondary small">#@purchase.StoryId</td>
                                            <td class="fw-bold text-light">@purchase.StoryTitle</td>
                                            <td class="text-warning">@purchase.PricePaid.ToString("F2") EGP</td>
                                            <td class="text-secondary small">@purchase.PurchasedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary small py-2">لا توجد عمليات شراء مسجلة لهذا الحساب.</div>
                    }
                </div>

            </div>

        </div>
    </div>
</div>

<script>
    function toggleReadPass(pass, btn) {
        var el = document.getElementById('cust-pass-read');
        if (el.textContent === '••••••••') {
            el.textContent = pass;
            btn.textContent = 'إخفاء';
        } else {
            el.textContent = '••••••••';
            btn.textContent = 'عرض';
        }
    }
</script>